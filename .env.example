# Variables d'environnement lues par ajaley/settings.py (elles ne sont PAS chargées depuis un fichier :
# à définir dans le terminal, ex. `export DJANGO_DEBUG=False`). Toutes sont facultatives en développement.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=une-longue-cle-secrete-aleatoire   # obligatoire si DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1             # séparés par des virgules
